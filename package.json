{
  "name": "real-estate-platform",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:auth": "node dist/subgraphs/auth/index.js",
    "start:user": "node dist/subgraphs/user/index.js",
    "start:property": "node dist/subgraphs/property/index.js",
    "start:gateway": "node dist/gateway/index.js",
    "start:all": "npm-run-all --parallel start:auth start:user start:property",
    "dev:auth": "tsx watch src/subgraphs/auth/index.ts",
    "dev:user": "nodemon --watch src --exec tsx --loader ts-node/esm src/subgraphs/user/index.ts",
    "dev:gateway": "tsx watch src/gateway/index.ts",
    "dev:property": "nodemon --watch src --exec tsx --loader ts-node/esm src/subgraphs/property/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@apollo/client": "^4.0.13",
    "@apollo/server": "^5.2.0",
    "@apollo/subgraph": "^2.12.2",
    "@as-integrations/express4": "^1.1.2",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/utils": "^10.11.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cross-fetch": "^4.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "lodash": "^4.17.21",
    "mongoose": "^9.0.2",
    "nodemon": "^3.1.11",
    "redis": "^5.10.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@apollo/gateway": "^2.13.0",
    "@jest/globals": "^30.2.0",
    "@types/node": "^25.2.3",
    "jest": "^30.2.0",
    "typescript": "^5.9.3"
  }
}
