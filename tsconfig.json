{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@subgraphs/*": ["src/subgraphs/*"],
      "@infrastructure/*": ["src/infrastructure/*"]
    }
  },
    "include": ["src", "__tests__"]
}