{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeminiSecurityService Response",
  "type": "object",
  "properties": {
    "riskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "The assessed risk level of the interaction."
    },
    "suggestedAction": {
      "type": "string",
      "enum": ["ALLOW", "CHALLENGE", "FLAG"],
      "description": "Recommended action. Note: FLAG implies logging/alerting without blocking."
    },
    "reason": {
      "type": "string",
      "description": "A clear, concise explanation for the decision."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["riskLevel", "suggestedAction", "reason", "confidence"],
  "additionalProperties": false
}